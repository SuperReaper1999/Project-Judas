// Public prefab construction remaps the complete mechanical assembly. The fixture
// chooses an empty place; real UI/inputs still control the constructed car.
 auto spawned=std::make_shared<EntityId>(0);
 job(5,[&,spawned](EngineHost&,RuntimeWorld& w){SceneTransform place;PhysicsQueryFilter f;f.requiredTags=1;auto floor=w.Physics().Raycast({55,100,35},{0,-1,0},200,f);Check(floor.hit,"prefab fixture has genuine terrain");place.position={55,floor.point.y+1.0f,35};std::string error;*spawned=w.SpawnPrefab("14af9982203bb6c9e15378daea6df542",place,error);Check(*spawned&&*spawned!=7000,"ordinary prefab constructs new identity: "+error);});
 job(1,[&,spawned](EngineHost&,RuntimeWorld& w){if(!PersonState(w,*spawned).contains("bag")){--index;return;}auto* power=w.RuntimePowertrain(*spawned);Check(power&&power->state.available,"spawned prefab has live remapped powertrain");unsigned wheels=0;for(auto& obj:w.ScriptObjects())if(obj.parent==*spawned){auto* wheel=w.RuntimeWheel(obj.id);if(wheel&&wheel->state.available)++wheels;}Check(wheels==4,"spawned prefab has all four remapped wheel endpoints");AimVehicleFixture(w,*spawned);});
 job(5,[&](EngineHost&,RuntimeWorld&){press("interact");});click("primary");
 job(10,[&,spawned](EngineHost&,RuntimeWorld& w){Check(State(w)["transport"]["driving"]=="entity:"+std::to_string(*spawned),"real vehicle UI controls instantiated prefab, not original car");start=w.Physics().GetTransform(w.RuntimeBody(*spawned)).position;held={"move_y"};});
 job(180,[&,spawned](EngineHost& h,RuntimeWorld& w){held={};Check(glm::distance(start,w.Physics().GetTransform(w.RuntimeBody(*spawned)).position)>1,"constructed native assembly drives physically");Check(PersonState(w,*spawned)["fuel"].get<double>()<28,"constructed vehicle consumes its own fuel");Check(PersonState(w,7000)["fuel"]==28,"original vehicle remains independent");Screenshot(h,out/"prefab-driving.png");done=true;Quit();});
