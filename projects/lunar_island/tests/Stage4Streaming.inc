// Genuine region teardown/reconstruction, ordinary JS cargo, then whole-assembly
// adoption before driving. No vehicle pose/state or inventory is injected.
 auto observations=std::make_shared<Json>(Json::object());
 auto waitRegion=[&](std::string state,std::function<void(EngineHost&,RuntimeWorld&,WorldStreaming&)> ready){job(1,[&,state,ready](EngineHost& h,RuntimeWorld& w){auto* stream=w.SceneControl()->StreamingIfLoaded();bool found=false;if(stream)for(auto& s:stream->Regions())if(s.id=="transport_garage"){if(s.state=="failed"||s.state=="blocked")throw std::runtime_error("garage "+s.state+": "+s.error);found=s.state==state;}if(!found){--index;return;}ready(h,w,*stream);});};
 waitRegion("active",[&,observations](EngineHost&,RuntimeWorld& w,WorldStreaming& stream){auto id=stream.Resolve("transport_garage",7600);Check(id&&w.RuntimeBody(id).IsValid(),"garage publishes real authored regional truck");(*observations)["oldId"]=id;AimVehicleFixture(w,id);});
 job(5,[&](EngineHost&,RuntimeWorld&){press("interact");});click("secondary");
 job(4,[&](EngineHost&,RuntimeWorld& w){auto h=w.UI().Find("lunar");w.UI().Select(h,"entries2",-1);w.UI().Focus(h,"entries2");press("ui_down");});click("secondary");
 job(5,[&,observations](EngineHost&,RuntimeWorld& w){EntityId id=(*observations)["oldId"].get<EntityId>();Check(Count(State(w),"wood")==1&&Count(PersonState(w,id),"wood")==3,"one real timber transfers out of regional cargo");(*observations)["bag"]=PersonState(w,id)["bag"];(*observations)["position"]=J(w.Physics().GetTransform(w.RuntimeBody(id)).position);press("pause");});
 job(6,[&](EngineHost&,RuntimeWorld& w){Aim(w,{800,30,650},25);});
 waitRegion("unloaded",[&,observations](EngineHost&,RuntimeWorld& w,WorldStreaming& stream){auto id=(*observations)["oldId"].get<EntityId>();Check(!w.RuntimeDefinition(id)&&!w.RuntimeBody(id).IsValid(),"leaving actually destroys regional runtime body and script");Check(stream.Stats().retainedBytes>0,"inactive garage retains bounded snapshot state");Check(w.RuntimeBody(7100).IsValid(),"unrelated root-owned truck remains available");Aim(w,{35,15,49},14,7);});
 waitRegion("active",[&,observations](EngineHost& h,RuntimeWorld& w,WorldStreaming& stream){auto id=stream.Resolve("transport_garage",7600);Check(id&&id!=(*observations)["oldId"].get<EntityId>(),"return allocates a new live regional entity generation");std::cout<<"REGIONAL BAG expected "<<(*observations)["bag"].dump()<<" actual "<<PersonState(w,id).dump()<<std::endl;Check(glm::distance(w.Physics().GetTransform(w.RuntimeBody(id)).position,V((*observations)["position"]))<.1f,"regional physical position survives suspension");Check(w.RuntimePowertrain(id)&&w.RuntimePowertrain(id)->state.available,"regional drivetrain is genuinely reconstructed");unsigned wheels=0;for(unsigned local=7602;local<=7605;++local){auto* wheel=w.RuntimeWheel(stream.Resolve("transport_garage",local));if(wheel&&wheel->state.available)++wheels;}Check(wheels==4,"all four remapped regional wheels are available");(*observations)["newId"]=id;Screenshot(h,out/"regional-restored.png");AimVehicleFixture(w,id);});
 // Physical region publication precedes asynchronous script instantiation. Wait
 // for the state to exist, never for its value to become the expected quantity.
 job(1,[&,observations](EngineHost&,RuntimeWorld& w){auto id=(*observations)["newId"].get<EntityId>();auto state=PersonState(w,id);if(!state.contains("bag")){--index;return;}Check(state["bag"]==(*observations)["bag"],"script-ready regional reconstruction restores exact depleted cargo");});
 job(5,[&](EngineHost&,RuntimeWorld&){press("interact");});click("primary");
 job(10,[&,observations](EngineHost&,RuntimeWorld& w){auto id=(*observations)["newId"].get<EntityId>();auto* stream=w.SceneControl()->StreamingIfLoaded();Check(State(w)["transport"]["driving"]=="region:transport_garage:7600","regional driver's durable reference retains identity");Check(stream->Owner(id)=="root","entering adopts complete mobile assembly into persistent root ownership");for(auto& obj:w.ScriptObjects())if(obj.parent==id)Check(stream->Owner(obj.id)=="root","vehicle child ownership follows whole assembly");start=w.Physics().GetTransform(w.RuntimeBody(id)).position;held={"move_y"};});
 job(180,[&,observations](EngineHost&,RuntimeWorld& w){auto id=(*observations)["newId"].get<EntityId>();Check(glm::distance(start,w.Physics().GetTransform(w.RuntimeBody(id)).position)>1,"reconstructed and adopted regional truck drives physically");Check(Count(PersonState(w,id),"wood")==3,"cargo survives regional reload, adoption and driving");held={"jump"};});
 job(150,[&](EngineHost&,RuntimeWorld&){held={};press("pause");});job(5,[&](EngineHost&,RuntimeWorld&){press("save");});job(30,[&](EngineHost&,RuntimeWorld&){});
