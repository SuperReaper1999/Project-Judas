// Non-integral render/fixed cadence exposes hierarchy double interpolation.
 job(8,[&](EngineHost&,RuntimeWorld& w){AimVehicleFixture(w,7400);});
 job(5,[&](EngineHost&,RuntimeWorld&){press("interact");});click("primary");
 job(10,[&](EngineHost&,RuntimeWorld& w){Check(State(w)["transport"]["driving"]=="entity:7400","normal vehicle UI boards helicopter");start=w.Physics().GetTransform(w.RuntimeBody(7400)).position;held={"jump"};});
 job(900,[&](EngineHost& h,RuntimeWorld& w){auto t=w.Physics().GetTransform(w.RuntimeBody(7400));Check(t.position.y>start.y+5,"real rotor takeoff climbs clear of ground");cruiseStart=t.position;flightAltitude=t.position.y;held={"move_y"};flightFrames=1;Screenshot(h,out/"takeoff.png");});
 job(1800,[&](EngineHost& h,RuntimeWorld& w){auto t=w.Physics().GetTransform(w.RuntimeBody(7400));auto v=w.Physics().GetLinearVelocity(w.RuntimeBody(7400));Check(glm::length(glm::vec2(v.x,v.z))>20,"full forward cruise exceeds 72 km/h without teleport or velocity assignment");Check(t.position.y>flightAltitude-5,"cruise preserves altitude instead of falling through reduced vertical lift");Check(PersonState(w,7400)["health"].get<float>()>90,"normal flight avoids crash damage");Write(out/"FLIGHT.json",{{"renderHz",90},{"fixedHz",60},{"durationSeconds",20},{"displacement",J(t.position-cruiseStart)},{"velocity",J(v)},{"peakSpeed",flightPeakSpeed},{"visualErrorMaxM",visualError},{"rotorOffsetErrorMaxM",rotorError},{"state",PersonState(w,7400)}});Check(visualError<.001,"body-free shell follows interpolated parent exactly once");Check(rotorError<.001,"rotor mount follows same interpolated parent as shell/camera");Screenshot(h,out/"cruise.png");held={};});
 job(900,[&](EngineHost& h,RuntimeWorld& w){auto v=w.Physics().GetLinearVelocity(w.RuntimeBody(7400));Check(glm::length(glm::vec2(v.x,v.z))<10,"released controls settle horizontal flight without a velocity reset");Check(PersonState(w,7400)["fuel"].get<float>()<90,"actual flight consumes fuel");Screenshot(h,out/"hover.png");flightFrames=0;done=true;Quit();});
