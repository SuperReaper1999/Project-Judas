// Isolated authored fixture, same gameplay modules. No runtime NPC teleport,
// health, inventory, damage or quest injection. Only player positioning/aim.
  auto talk=[&](EntityId id){job(6,[&,id](EngineHost&,RuntimeWorld& w){AimEntityFixture(w,id);});job(5,[&](EngineHost&,RuntimeWorld&){press("interact");});};
  talk(6000);click("primary");job(5,[&](EngineHost&,RuntimeWorld&){press("pause");});
  job(5,[&](EngineHost&,RuntimeWorld&){press("inventory");});click("tab_pack");
  job(4,[&](EngineHost&,RuntimeWorld& w){auto state=State(w);int row=0;for(auto& slot:state["bag"]["slots"]){if(slot.is_null())continue;if(slot["item"]=="pistol")break;++row;}auto h=w.UI().Find("lunar");w.UI().Select(h,"entries",row-1);w.UI().Focus(h,"entries");press("ui_down");});click("primary");job(5,[&](EngineHost&,RuntimeWorld& w){Check(State(w)["equipped"]=="pistol","fixture actually equips the quest pistol");press("pause");});
  job(5,[&](EngineHost&,RuntimeWorld&){press("reload");});job(95,[&](EngineHost&,RuntimeWorld& w){Check(State(w)["combat"]["magazines"]["pistol"]==10,"fixture earns and loads real quest pistol");AimEntityFixture(w,3120);});
  job(5,[&](EngineHost&,RuntimeWorld&){press("interact");});click("primary");
  for(int i=0;i<2;++i){job(3,[](EngineHost&,RuntimeWorld& w){auto h=w.UI().Find("lunar");w.UI().Select(h,"entries2",-1);w.UI().Focus(h,"entries2");});job(3,[&](EngineHost&,RuntimeWorld&){press("ui_down");});click("tertiary");}
  job(5,[&](EngineHost&,RuntimeWorld& w){Check(Count(State(w),"planks")==2&&Count(State(w),"nails")==2,"fixture loots exact real barricade supplies");press("pause");});
  job(6,[&](EngineHost&,RuntimeWorld& w){Aim(w,{-13.6f,15.53f,-5.5f},14);});job(5,[&](EngineHost&,RuntimeWorld&){press("interact");});click("primary");
  job(6,[&](EngineHost&,RuntimeWorld& w){brokenBoard=FindNamed(w,"Barricade / wood");Check(brokenBoard&&w.RuntimeJoint(brokenBoard).IsValid(),"actual window receives a physical board and joint");Check(!w.UI().Paused(),"successful barricading returns to active gameplay");});
  job(6,[&](EngineHost&,RuntimeWorld& w){Aim(w,{-12.5f,15.2f,-12},14.25f,4,{0,0,1});});
  job(45,[&](EngineHost&,RuntimeWorld& w){Check(PersonState(w,6210)["mode"]=="patrol"&&BarricadeHealth(State(w))==60,"unalerted enemy does not damage an unheard unseen barricade");Check(PersonState(w,6210)["health"]==65,"guard health is unchanged before real shot");press("primary");});
  job(40,[&](EngineHost&,RuntimeWorld& w){Check(State(w)["combat"]["magazines"]["pistol"]==9,"actual shot spends ammunition and alerts nearby enemy");Check(PersonState(w,6210)["health"]==65,"miss does not damage enemy through the wall");auto npcPosition=w.RuntimeDefinition(6210)->transform.position, playerPosition=w.RuntimeDefinition(100)->transform.position;
for(float height:{1.f,1.4f}){PhysicsQueryFilter filter;filter.ignoredBodies.push_back(w.RuntimeBody(6210));auto ray=w.Physics().Raycast(npcPosition+glm::vec3(0,height,0),glm::normalize(playerPosition-npcPosition),1.8f,filter);std::cout<<"BARRIER RAY height "<<height<<" npc "<<J(npcPosition).dump()<<" player "<<J(playerPosition).dump()<<" hit "<<(ray.hit?w.EntityIdOfBody(ray.body):0)<<" point "<<J(ray.point).dump()<<std::endl;}
std::cout<<"BARRIER EARLY health "<<BarricadeHealth(State(w))<<" npc "<<PersonState(w,6210).dump()<<std::endl;Check(BarricadeHealth(State(w))<60,"hearing-driven enemy damages a physically reached barricade");});
  job(480,[&](EngineHost& h,RuntimeWorld& w){std::cout<<"BARRIER FINAL "<<State(w)["housing"]["objects"].dump()<<" npc "<<PersonState(w,6210).dump()<<std::endl;Check(brokenBoard&&!w.RuntimeBody(brokenBoard).IsValid(),"repeated real enemy attacks remove the blocking physical board");Check(Count(State(w),"planks")==0,"enemy destruction does not refund construction materials");Screenshot(h,out/"barricade-breach.png");done=true;Quit();});
