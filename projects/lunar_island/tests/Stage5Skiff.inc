const auto harbour=Read(project.parent_path()/"Authoring/region_manifest.json")["regions"]["harbour"];
const auto centre=V(harbour["position"]);
job(5,[&,centre](EngineHost&,RuntimeWorld& w){Aim(w,centre+glm::vec3(0,1,0),centre.y);});
job(1,[&,centre](EngineHost&,RuntimeWorld& w){auto* stream=w.SceneControl()->StreamingIfLoaded();auto id=stream->Resolve("harbour",36000);if(!id||!PersonState(w,id).contains("fuel")){--index;return;}Aim(w,w.Physics().GetTransform(w.RuntimeBody(id)).position,.9f,2.5f,{-1,0,0});});
job(5,[&](EngineHost&,RuntimeWorld&){press("interact");});click("primary");
job(180,[&](EngineHost&,RuntimeWorld& w){auto* stream=w.SceneControl()->StreamingIfLoaded();auto id=stream->ResolvePersistentKey("region:harbour:36000");Check(State(w)["transport"]["driving"]=="region:harbour:36000","ocean skiff boards through actual dock interaction");Check(id&&stream->Owner(id)=="root","piloting transfers the full mobile skiff assembly safely");auto y=w.Physics().GetTransform(w.RuntimeBody(id)).position.y;Check(y>-.3f&&y<.3f,"actual skiff floats at ocean level, not the inland spring height");Check(!w.AdvancedFluidsEnabled(),"ocean boat uses basic water with advanced fluids disabled");press("interact");});
job(20,[&,centre](EngineHost& h,RuntimeWorld& w){Check(State(w)["transport"]["driving"].is_null()&&w.RuntimeCharacter(100)->settings.enabled,"dock exit restores actual on-foot CharacterMotor");auto pos=w.RuntimeCharacter(100)->position;Check(pos.y>.8f&&pos.x<centre.x+3,"boat selects the dry physical pier before open water");Screenshot(h,out/"dry-dock-exit.png");done=true;Quit();});
