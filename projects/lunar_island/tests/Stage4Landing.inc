 const bool helicopter=mode=="land-helicopter";const EntityId vehicle=helicopter?7400:7500;
 job(7,[&,vehicle](EngineHost&,RuntimeWorld& w){AimVehicleFixture(w,vehicle);});job(5,[&](EngineHost&,RuntimeWorld&){press("interact");});click("primary");
 job(10,[&,helicopter,vehicle](EngineHost&,RuntimeWorld& w){Check(!w.RuntimeCharacter(100)->settings.enabled,"landing flight enters actual aircraft");start=w.Physics().GetTransform(w.RuntimeBody(vehicle)).position;held={helicopter?"jump":"move_y"};});
 job(helicopter?480:300,[&,helicopter](EngineHost&,RuntimeWorld&){held={"jump"};});
 job(helicopter?5:180,[&,vehicle,helicopter](EngineHost& h,RuntimeWorld& w){Check(w.Physics().GetTransform(w.RuntimeBody(vehicle)).position.y>start.y+2,"landing proof begins after genuine physical takeoff");Screenshot(h,out/"airborne.png");held={"dive"};reverseThrottle=!helicopter;});
 job(1,[&,vehicle,helicopter](EngineHost&,RuntimeWorld& w){bool grounded=false;std::vector<PhysicsWorld::BodyContactSample> contacts;w.Physics().ReadBodyContactSample(w.RuntimeBody(vehicle),contacts);for(auto& c:contacts){auto* def=w.RuntimeDefinition(w.EntityIdOfBody(c.other));if(def&&(def->tags&1)&&std::abs(c.normal.y)>.6)grounded=true;}for(auto& obj:w.ScriptObjects())if(obj.wheel&&obj.wheel->chassis==vehicle){auto* wheel=w.RuntimeWheel(obj.id);auto* ground=wheel?w.RuntimeDefinition(w.EntityIdOfBody(wheel->state.body)):nullptr;if(wheel&&wheel->state.contact&&ground&&(ground->tags&1))grounded=true;}if(!grounded){--index;return;}std::cout<<"LANDED physical "<<J(w.Physics().GetTransform(w.RuntimeBody(vehicle)).position).dump()<<" velocity "<<J(w.Physics().GetLinearVelocity(w.RuntimeBody(vehicle))).dump()<<std::endl;reverseThrottle=false;held={helicopter?"dive":"sprint"};});
 job(480,[&,vehicle](EngineHost&,RuntimeWorld& w){held={};Check(glm::length(w.Physics().GetLinearVelocity(w.RuntimeBody(vehicle)))<3,"landed aircraft slows enough for a safe exit");Check(PersonState(w,vehicle)["health"].get<double>()>0,"controlled landing preserves usable aircraft");press("interact");});
 job(10,[&,vehicle](EngineHost& h,RuntimeWorld& w){Check(State(w)["transport"]["driving"].is_null()&&w.RuntimeCharacter(100)->settings.enabled,"landing then E restores on-foot control outside actual aircraft collision");std::cout<<"LANDING FINAL "<<PersonState(w,vehicle).dump()<<std::endl;Screenshot(h,out/"landed-exited.png");done=true;Quit();});
