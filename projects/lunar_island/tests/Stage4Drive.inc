// Real body movement and native mechanical state; only player placement/aim is a fixture.
 const auto definition=Read(project.parent_path()/"Authoring/vehicle_manifest.json")[mode.substr(6)];
 const EntityId vehicleId=definition["entity"].get<EntityId>();
 job(8,[&,vehicleId](EngineHost&,RuntimeWorld& w){AimVehicleFixture(w,vehicleId);});
 job(5,[&](EngineHost&,RuntimeWorld&){press("interact");});click("primary");
 job(10,[&,vehicleId](EngineHost& h,RuntimeWorld& w){Check(State(w)["transport"]["driving"]=="entity:"+std::to_string(vehicleId),"ordinary E/menu enters selected vehicle");Check(!w.RuntimeCharacter(100)->settings.enabled,"pilot's actual CharacterMotor is disabled");start=w.Physics().GetTransform(w.RuntimeBody(vehicleId)).position;std::cout<<"VEHICLE START "<<vehicleId<<" "<<J(start).dump()<<" state "<<PersonState(w,vehicleId).dump()<<std::endl;Screenshot(h,out/"entered.png");held={mode=="drive-helicopter"?"jump":"move_y"};});
 job(mode=="drive-helicopter"?480:mode=="drive-plane"?300:180,[&,vehicleId](EngineHost&,RuntimeWorld& w){if(mode=="drive-plane")held={"jump"};else held={};auto t=w.Physics().GetTransform(w.RuntimeBody(vehicleId));std::cout<<"VEHICLE FIRST endpoint "<<J(t.position).dump()<<" velocity "<<J(w.Physics().GetLinearVelocity(w.RuntimeBody(vehicleId))).dump()<<std::endl;});
 job(mode=="drive-plane"?240:4,[&,vehicleId,definition](EngineHost& h,RuntimeWorld& w){held={};auto t=w.Physics().GetTransform(w.RuntimeBody(vehicleId));auto state=PersonState(w,vehicleId);Check(glm::distance(t.position,start)>1,"actual physical vehicle changes position under controls");Check(state["fuel"].get<double>()<definition["fuel"].get<double>(),"propulsion consumes persistent fuel");Check(state["health"].get<double>()>0,"normal movement does not wreck vehicle");if(mode=="drive-helicopter"||mode=="drive-plane")Check(t.position.y>start.y+2,"physical lift raises aircraft above starting ground");if(mode=="drive-boat")Check(t.position.y>9&&t.position.y<11,"prescribed-water flotation keeps actual boat afloat");auto* power=w.RuntimePowertrain(vehicleId);Check(power&&power->state.available,"native powertrain endpoints remain available");for(auto& shaft:power->state.shafts)std::cout<<"SHAFT "<<shaft.angularVelocity<<" torque "<<shaft.torque<<std::endl;for(auto& id:definition["wheels"]){auto* wheel=w.RuntimeWheel(std::stoull(id.get<std::string>()));std::cout<<"WHEEL "<<id<<" available "<<wheel->state.available<<" contact "<<wheel->state.contact<<" overlap "<<wheel->state.initialOverlap<<" length "<<wheel->state.length<<" load "<<wheel->state.normalForce<<std::endl;}std::cout<<"VEHICLE FINAL "<<J(t.position).dump()<<" up "<<J(t.rotation*glm::vec3(0,1,0)).dump()<<" state "<<state.dump()<<std::endl;Screenshot(h,out/"driving.png");done=true;Quit();});
