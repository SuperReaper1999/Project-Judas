  "known_findings": [
    {"id":"FLU-ROOT-ADMISSION","status":"resolved-local-reconstruction","scheduled":true,"reason":"Physical non-solid admission uses actual particle cubes and compact pair lenses, not nominal-bin occupancy. All original 34 controls pass unchanged, with neutral/swimming and existing vertical support preserved. New geometric/force controls cover compact support and numerical tangency. This is bounded sampling reconstruction, not exact multiphase topology or a conserved-volume solve. See docs/FLUID_LOCAL_WET_RECONSTRUCTION.txt.","evidence":"docs/evidence/fluid-local-wet-20261102"},
