  "known_findings": [
    {"id":"CCD-MESH-ARRIVAL","status":"resolved-first-arrival","scheduled":true,"reason":"Pass2 finite swept-SAT bounds correct the validated first-arrival contract; it now runs in the ordinary collision group. This does not close later curved-sheet continuation.","evidence":"docs/evidence/prealpha-pass2/physics"},
    {"id":"CCD-MESH-CONTINUATION","status":"resolved-original-fixtures-bounded-ccd","scheduled":true,"reason":"Original unchanged mesh arrival/continuation fixtures pass with authoritative MK2. Bounded CCD, sidedness and deep initial-overlap limits remain; MK1 event scheduling has been removed.","evidence":"docs/evidence/prealpha-ccd-continuation-20261019"},
    {"id":"FLU-001","status":"deferred-failing","scheduled":false,"reason":"Legacy PBF settling contract retained unchanged; separate fluid review required.","evidence":"docs/evidence/m78-completion/FINDINGS_FINAL.json"},
    {"id":"LEGACY-CONTINUATION","status":"documented-incompatible-history","scheduled":false,"reason":"Original a106 snapshot lacks historical continuation data. New-format passes do not certify that snapshot.","evidence":"docs/evidence/m78-cold-boundary"},
    {"id":"DENSE-CCD-TAIL","status":"open-performance-limit","scheduled":false,"reason":"Original MK1 global event cascade is retired. Current MK2 measurements have their own workload scope; focused correctness gates do not certify universal dense-pile latency.","evidence":"docs/MK2_PHYSICS_ARCHITECTURE.md"},
    {"id":"LIQUID-BAKE-ROTATION","status":"resolved-baking","scheduled":true,"reason":"Baker and runtime use the same normalized owner/field frames and oriented gravity volumes; both original bake-only runtime-publication cases pass unchanged equivalence tolerances. Original full integration exposes separate retained exact-total comparison failure.","evidence":"docs/evidence/prealpha-liquid-rotation/REPORT.md"},
    {"id":"LIQUID-BAKE-KNOTS","status":"resolved-baking","scheduled":true,"reason":"Positive tetrahedral density is integrated into one monotone cumulative curve, including shared endpoints; unchanged strict Surface1 decoder accepts both original rotated bakes. A later origin sampling limitation remains separately failed.","evidence":"docs/evidence/prealpha-liquid-rotation/REPORT.md"},
    {"id":"LIQUID-ORIGIN-GRID-QUERY","status":"open-query-continuity-failing","scheduled":false,"reason":"The original half-turn fixture now bakes and publishes, then fails its unchanged post-512m-origin query comparison: float translation crosses a discontinuous disturbed-surface cell boundary. Conserved quantities and wave bytes remain unchanged. This full integration failure is preserved, not counted as a baking pass.","evidence":"docs/evidence/prealpha-liquid-rotation/REPORT.md"},
    {"id":"LIQUID-ORIGIN-TOTAL-IDENTITY","status":"resolved-oracle-causal-baseline","scheduled":true,"reason":"Pass3 preserves the original failed test and demonstrates its causal-baseline error. Current atomicity compares the immediate pre-request total with the same exact equality and every physical participant byte; earlier legitimate paired-flow conservation tolerance and liquid runtime are unchanged.","evidence":"docs/evidence/prealpha-pass3/integration/REPORT.md"}
  ]
