# One catalogue supplies compiled modules, library parts and native registration.
# New operations in an existing module do not modify the central dispatcher.
set(judas_scripting_catalogue "${CMAKE_CURRENT_SOURCE_DIR}/src/scripting/Modules.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${judas_scripting_catalogue}")
file(READ "${judas_scripting_catalogue}" judas_scripting_document)
string(JSON judas_scripting_schema GET "${judas_scripting_document}" schema)
if(NOT judas_scripting_schema EQUAL 1)
    message(FATAL_ERROR "Unsupported Judas scripting catalogue schema")
endif()

function(judas_validate_scripting_source source)
    if(NOT source MATCHES "^[A-Za-z_0-9/.-]+$" OR
       source MATCHES "(^/|//|/$|(^|/)\\.\\.?(/|$))" OR
       NOT EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/${source}" OR
       IS_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/${source}")
        message(FATAL_ERROR "Invalid Judas scripting source: ${source}")
    endif()
endfunction()

set(JUDAS_SCRIPTING_SOURCES src/scripting/ScriptLibrary.cpp)
judas_validate_scripting_source(src/scripting/ScriptLibrary.cpp)
set(judas_scripting_includes "")
set(judas_scripting_append "")
set(judas_scripting_registrations "")
set(judas_scripting_libraries_names "")
set(judas_scripting_modules_names "")
set(judas_scripting_sources "")
set(judas_scripting_symbols "")
set(judas_scripting_registration_names "")
foreach(kind libraries modules)
    string(JSON count LENGTH "${judas_scripting_document}" ${kind})
    if(count EQUAL 0)
        continue()
    endif()
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON name GET "${judas_scripting_document}" ${kind} ${index} name)
        if(NOT name MATCHES "^[A-Za-z_][A-Za-z_0-9]*$" OR
           name IN_LIST judas_scripting_${kind}_names)
            message(FATAL_ERROR "Invalid or duplicate Judas scripting ${kind} name: ${name}")
        endif()
        list(APPEND judas_scripting_${kind}_names "${name}")
        string(JSON source GET "${judas_scripting_document}" ${kind} ${index} source)
        judas_validate_scripting_source("${source}")
        if(source IN_LIST judas_scripting_sources)
            message(FATAL_ERROR "Duplicate Judas scripting source: ${source}")
        endif()
        list(APPEND judas_scripting_sources "${source}")
        if(kind STREQUAL "libraries")
            string(JSON symbol GET "${judas_scripting_document}" libraries ${index} symbol)
            if(NOT symbol MATCHES "^[A-Za-z_][A-Za-z_0-9]*(::[A-Za-z_][A-Za-z_0-9]*)*$" OR
               symbol IN_LIST judas_scripting_symbols)
                message(FATAL_ERROR "Invalid or duplicate Judas scripting library symbol: ${symbol}")
            endif()
            list(APPEND judas_scripting_symbols "${symbol}")
            string(APPEND judas_scripting_includes "#include \"${CMAKE_CURRENT_SOURCE_DIR}/${source}\"\n")
            string(APPEND judas_scripting_append "        source.append(${symbol});\n")
        else()
            string(JSON registration GET "${judas_scripting_document}" modules ${index} registration)
            if(NOT registration MATCHES "^[A-Za-z_][A-Za-z_0-9]*$" OR
               registration IN_LIST judas_scripting_registration_names)
                message(FATAL_ERROR "Invalid or duplicate Judas scripting registration: ${registration}")
            endif()
            list(APPEND judas_scripting_registration_names "${registration}")
            list(APPEND JUDAS_SCRIPTING_SOURCES "${source}")
            string(APPEND judas_scripting_registrations "JUDAS_SCRIPT_MODULE(${registration})\n")
        endif()
    endforeach()
endforeach()

# API tooling uses these compiled helpers to verify structured result fields.
string(JSON judas_scripting_value_count LENGTH "${judas_scripting_document}" valueSources)
if(judas_scripting_value_count GREATER 0)
    math(EXPR last "${judas_scripting_value_count} - 1")
    set(judas_scripting_value_sources "")
    foreach(index RANGE 0 ${last})
        string(JSON source GET "${judas_scripting_document}" valueSources ${index})
        judas_validate_scripting_source("${source}")
        if(source IN_LIST judas_scripting_value_sources)
            message(FATAL_ERROR "Duplicate Judas scripting value source: ${source}")
        endif()
        list(APPEND judas_scripting_value_sources "${source}")
    endforeach()
endif()

set(JUDAS_SCRIPTING_GENERATED_DIR "${CMAKE_CURRENT_BINARY_DIR}/generated/scripting")
file(MAKE_DIRECTORY "${JUDAS_SCRIPTING_GENERATED_DIR}")
file(CONFIGURE OUTPUT "${JUDAS_SCRIPTING_GENERATED_DIR}/ScriptLibraryIncludes.inc"
     CONTENT "${judas_scripting_includes}" @ONLY)
file(CONFIGURE OUTPUT "${JUDAS_SCRIPTING_GENERATED_DIR}/ScriptLibraryAppend.inc"
     CONTENT "${judas_scripting_append}" @ONLY)
file(CONFIGURE OUTPUT "${JUDAS_SCRIPTING_GENERATED_DIR}/ScriptModuleRegistrations.inc"
     CONTENT "${judas_scripting_registrations}" @ONLY)
