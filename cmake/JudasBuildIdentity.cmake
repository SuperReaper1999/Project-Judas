# Explicit release identity. This module can also be used by a small CMake
# project or cmake -P without configuring Judas's graphics/tool dependencies.
include_guard(GLOBAL)

function(judas_build_identity source_root output_directory)
    file(REAL_PATH "${source_root}" real_source_root)
    file(READ "${source_root}/engine-version.json" version_document)
    string(JSON version_schema ERROR_VARIABLE version_error GET "${version_document}" schema)
    if(version_error OR NOT version_schema EQUAL 1)
        message(FATAL_ERROR "engine-version.json: unsupported or missing identity schema")
    endif()
    string(JSON version GET "${version_document}" version)
    string(JSON maturity GET "${version_document}" maturity)
    set(JUDAS_ENGINE_VERSION "" CACHE STRING "Optional engine version override; empty follows engine-version.json")
    if(JUDAS_ENGINE_VERSION STREQUAL "")
        set(effective_version "${version}")
    else()
        set(effective_version "${JUDAS_ENGINE_VERSION}")
    endif()
    set(JUDAS_BUILD_CHANNEL "" CACHE STRING "Build channel: main, Experimental or Local; empty selects the current recognized branch")
    set_property(CACHE JUDAS_BUILD_CHANNEL PROPERTY STRINGS main Experimental Local)
    if(NOT effective_version MATCHES "^[0-9]+[.][0-9]+[.][0-9]+(-[A-Za-z0-9.-]+)?$"
       OR NOT maturity MATCHES "^[A-Za-z0-9.-]+$")
        message(FATAL_ERROR "Engine version/maturity contains an invalid or unsupported identity")
    endif()
    set(revision unknown)
    set(tree unknown)
    set(source_fingerprint unknown)
    set(source_dirty true)
    set(source_untracked_count 0)
    string(SHA256 source_untracked_fingerprint "")
    set(origin unknown)
    set(default_channel Local)
    find_program(judas_git git)
    if(judas_git)
        # Git may find a parent repository. Require this exact source root.
        execute_process(COMMAND "${judas_git}" -C "${source_root}" rev-parse --show-toplevel
            RESULT_VARIABLE git_result OUTPUT_VARIABLE git_root ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
        file(REAL_PATH "${source_root}" real_source_root)
        if(git_result EQUAL 0)
            file(REAL_PATH "${git_root}" real_git_root)
        endif()
        if(git_result EQUAL 0 AND real_git_root STREQUAL real_source_root)
            execute_process(COMMAND "${judas_git}" -C "${source_root}" rev-parse HEAD
                RESULT_VARIABLE revision_result OUTPUT_VARIABLE revision ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
            execute_process(COMMAND "${judas_git}" -C "${source_root}" rev-parse "HEAD^{tree}"
                RESULT_VARIABLE tree_result OUTPUT_VARIABLE tree ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
            if(NOT revision_result EQUAL 0 OR NOT tree_result EQUAL 0)
                message(FATAL_ERROR "Cannot read source Git revision/tree; refusing a guessed identity")
            endif()
            execute_process(COMMAND "${judas_git}" -C "${source_root}" symbolic-ref --quiet --short HEAD
                OUTPUT_VARIABLE branch ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
            if(branch STREQUAL "main" OR branch STREQUAL "Experimental")
                set(default_channel "${branch}")
            endif()
            # Tracked provenance and observed untracked files are separate. An
            # unrelated research source must not make every clean release dirty.
            # Candidate files become canonical tracked inputs when checkpointed.
            execute_process(COMMAND "${judas_git}" -C "${source_root}" diff HEAD --binary --no-ext-diff
                --full-index --no-color --no-renames --no-textconv --diff-algorithm=myers
                RESULT_VARIABLE diff_result OUTPUT_VARIABLE source_diff ERROR_QUIET)
            execute_process(COMMAND "${judas_git}" -C "${source_root}" -c core.quotepath=false ls-files --others --exclude-standard --
                CMakeLists.txt engine-version.json cmake src tools scripts tests platform packaging third_party assets
                RESULT_VARIABLE untracked_result OUTPUT_VARIABLE untracked ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
            if(NOT diff_result EQUAL 0 OR NOT untracked_result EQUAL 0)
                message(FATAL_ERROR "Cannot fingerprint source changes")
            endif()
            set(source_dirty false)
            set(fingerprint_input "${tree}\n${source_diff}")
            if(NOT source_diff STREQUAL "")
                set(source_dirty true)
            endif()
            set(untracked_fingerprint_input "")
            string(REPLACE "\n" ";" untracked_paths "${untracked}")
            list(FILTER untracked_paths EXCLUDE REGEX "(^|/)(__pycache__|[.]cache|node_modules)/|[.]py[co]$")
            list(SORT untracked_paths)
            foreach(path IN LISTS untracked_paths)
                if(EXISTS "${source_root}/${path}" AND NOT IS_DIRECTORY "${source_root}/${path}")
                    file(SHA256 "${source_root}/${path}" digest)
                    string(APPEND untracked_fingerprint_input "\n${path}:${digest}")
                    math(EXPR source_untracked_count "${source_untracked_count} + 1")
                    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source_root}/${path}")
                endif()
            endforeach()
            string(SHA256 source_fingerprint "${fingerprint_input}")
            string(SHA256 source_untracked_fingerprint "${untracked_fingerprint_input}")
            set(origin git)
            # --git-path handles linked worktrees, packed refs and branch changes.
            foreach(name HEAD index packed-refs refs/heads/main refs/heads/Experimental)
                execute_process(COMMAND "${judas_git}" -C "${source_root}" rev-parse --git-path "${name}"
                    OUTPUT_VARIABLE git_path ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
                if(NOT IS_ABSOLUTE "${git_path}")
                    set(git_path "${source_root}/${git_path}")
                endif()
                if(EXISTS "${git_path}")
                    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${git_path}")
                endif()
            endforeach()
        endif()
    endif()
    if(origin STREQUAL "unknown" AND EXISTS "${source_root}/JUDAS_SOURCE_INFO.json")
        file(READ "${source_root}/JUDAS_SOURCE_INFO.json" source_document)
        string(JSON source_schema ERROR_VARIABLE source_error GET "${source_document}" schema)
        if(source_error OR NOT source_schema EQUAL 1)
            message(FATAL_ERROR "JUDAS_SOURCE_INFO.json: unsupported source provenance schema")
        endif()
        foreach(field revision tree source_fingerprint source_dirty)
            string(JSON ${field} ERROR_VARIABLE field_error GET "${source_document}" "${field}")
            if(field_error)
                message(FATAL_ERROR "JUDAS_SOURCE_INFO.json: missing ${field}")
            endif()
        endforeach()
        string(LENGTH "${revision}" frozen_revision_length)
        string(LENGTH "${tree}" frozen_tree_length)
        string(LENGTH "${source_fingerprint}" frozen_fingerprint_length)
        if(NOT revision MATCHES "^[0-9a-f]+$" OR NOT frozen_revision_length EQUAL 40
            OR NOT tree MATCHES "^[0-9a-f]+$" OR NOT frozen_tree_length EQUAL 40
            OR NOT source_fingerprint MATCHES "^[0-9a-f]+$" OR NOT frozen_fingerprint_length EQUAL 64)
            message(FATAL_ERROR "Malformed frozen source archive provenance")
        endif()
        string(JSON dirty_type TYPE "${source_document}" source_dirty)
        if(NOT dirty_type STREQUAL "BOOLEAN")
            message(FATAL_ERROR "JUDAS_SOURCE_INFO.json: source_dirty must be a boolean")
        endif()
        # string(JSON) yields ON/OFF for booleans; normalize for JSON/header output.
        if(source_dirty)
            set(source_dirty true)
        else()
            set(source_dirty false)
        endif()
        string(JSON default_channel ERROR_VARIABLE channel_error GET "${source_document}" channel)
        if(channel_error)
            set(default_channel Local)
        endif()
        string(JSON expected_manifest_hash ERROR_VARIABLE manifest_hash_error GET "${source_document}" source_files_sha256)
        set(source_manifest_file "${source_root}/JUDAS_SOURCE_FILES.json")
        if(manifest_hash_error OR NOT EXISTS "${source_manifest_file}")
            message(FATAL_ERROR "Source archive requires JUDAS_SOURCE_FILES.json and its frozen source_files_sha256")
        endif()
        file(SHA256 "${source_manifest_file}" actual_manifest_hash)
        if(NOT actual_manifest_hash STREQUAL expected_manifest_hash)
            message(FATAL_ERROR "Source archive file manifest hash disagrees with frozen provenance")
        endif()
        file(READ "${source_manifest_file}" source_manifest)
        string(JSON manifest_schema ERROR_VARIABLE manifest_error GET "${source_manifest}" schema)
        string(JSON manifest_count ERROR_VARIABLE manifest_count_error LENGTH "${source_manifest}" files)
        if(manifest_error OR NOT manifest_schema EQUAL 1 OR manifest_count_error OR manifest_count LESS 1)
            message(FATAL_ERROR "Invalid source archive file inventory")
        endif()
        set(archive_changes "")
        set(archive_paths "")
        # The archive tool writes one complete file record per line. Parsing
        # each short record avoids repeatedly parsing a multi-MiB inventory.
        file(STRINGS "${source_manifest_file}" manifest_lines REGEX "\"path\"" ENCODING UTF-8)
        set(parsed_count 0)
        foreach(line IN LISTS manifest_lines)
            if(NOT line MATCHES "\"path\"")
                continue()
            endif()
            string(STRIP "${line}" record)
            string(REGEX REPLACE ",$" "" record "${record}")
            string(JSON path ERROR_VARIABLE path_error GET "${record}" path)
            string(JSON expected_hash ERROR_VARIABLE hash_error GET "${record}" sha256)
            if(path_error OR hash_error)
                message(FATAL_ERROR "Source archive inventory requires one complete file record per line")
            endif()
            math(EXPR parsed_count "${parsed_count} + 1")
            string(LENGTH "${expected_hash}" hash_length)
            if(IS_ABSOLUTE "${path}" OR path MATCHES "(^|/)[.][.](/|$)|[;\\\\]" OR path STREQUAL ""
                OR NOT expected_hash MATCHES "^[0-9a-f]+$" OR NOT hash_length EQUAL 64)
                message(FATAL_ERROR "Invalid or duplicate source archive inventory entry")
            endif()
            string(SHA256 path_key "${path}")
            if(DEFINED archive_seen_${path_key})
                message(FATAL_ERROR "Duplicate source archive inventory entry")
            endif()
            set(archive_seen_${path_key} true)
            list(APPEND archive_paths "${path}")
            if(EXISTS "${source_root}/${path}" AND NOT IS_DIRECTORY "${source_root}/${path}")
                file(REAL_PATH "${source_root}/${path}" actual_path)
                string(FIND "${actual_path}" "${real_source_root}/" inside_source)
                if(NOT inside_source EQUAL 0)
                    message(FATAL_ERROR "Source archive entry escapes its source root")
                endif()
                file(SHA256 "${source_root}/${path}" actual_hash)
                set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source_root}/${path}")
            else()
                set(actual_hash missing)
            endif()
            if(NOT actual_hash STREQUAL expected_hash)
                string(APPEND archive_changes "\n${path}:${actual_hash}")
            endif()
        endforeach()
        if(NOT parsed_count EQUAL manifest_count)
            message(FATAL_ERROR "Source archive inventory record count mismatch")
        endif()
        if(NOT "engine-version.json" IN_LIST archive_paths OR NOT "CMakeLists.txt" IN_LIST archive_paths)
            message(FATAL_ERROR "Source archive inventory omits required engine inputs")
        endif()
        file(GLOB_RECURSE archive_inputs LIST_DIRECTORIES false RELATIVE "${source_root}"
            "${source_root}/src/*" "${source_root}/cmake/*" "${source_root}/tools/*"
            "${source_root}/scripts/*" "${source_root}/tests/*" "${source_root}/platform/*"
            "${source_root}/packaging/*" "${source_root}/third_party/*" "${source_root}/assets/*")
        list(FILTER archive_inputs EXCLUDE REGEX "(^|/)(__pycache__|[.]cache|node_modules)/|[.]py[co]$")
        list(SORT archive_inputs)
        foreach(path IN LISTS archive_inputs)
            string(SHA256 path_key "${path}")
            if(NOT DEFINED archive_seen_${path_key})
                file(SHA256 "${source_root}/${path}" actual_hash)
                string(APPEND archive_changes "\nnew:${path}:${actual_hash}")
            endif()
        endforeach()
        if(NOT archive_changes STREQUAL "")
            set(source_dirty true)
            string(SHA256 source_fingerprint "${source_fingerprint}\n${archive_changes}")
        endif()
        set(origin archive)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source_root}/JUDAS_SOURCE_INFO.json")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source_manifest_file}")
    endif()
    if(NOT origin STREQUAL "unknown")
        string(LENGTH "${revision}" revision_length)
        string(LENGTH "${tree}" tree_length)
        string(LENGTH "${source_fingerprint}" fingerprint_length)
        if(NOT revision MATCHES "^[0-9a-f]+$" OR NOT revision_length EQUAL 40
            OR NOT tree MATCHES "^[0-9a-f]+$" OR NOT tree_length EQUAL 40
            OR NOT source_fingerprint MATCHES "^[0-9a-f]+$" OR NOT fingerprint_length EQUAL 64)
            message(FATAL_ERROR "Malformed source provenance; cannot publish a trustworthy build identity")
        endif()
    endif()
    if(JUDAS_BUILD_CHANNEL STREQUAL "")
        set(channel "${default_channel}")
    else()
        set(channel "${JUDAS_BUILD_CHANNEL}")
    endif()
    if(NOT channel MATCHES "^(main|Experimental|Local)$")
        message(FATAL_ERROR "JUDAS_BUILD_CHANNEL must be main, Experimental or Local")
    endif()
    if(origin STREQUAL "unknown")
        message(WARNING "No Git or JUDAS_SOURCE_INFO.json: source provenance is unknown; local builds work but release packaging must reject this identity")
    endif()
    if(source_dirty)
        set(dirty_suffix dirty)
    else()
        set(dirty_suffix clean)
    endif()
    string(SUBSTRING "${revision}" 0 7 short_revision)
    string(SUBSTRING "${source_fingerprint}" 0 12 short_fingerprint)
    set(build_id "${effective_version}-${channel}-${short_revision}-${dirty_suffix}-${short_fingerprint}")
    if(origin STREQUAL "git" AND source_untracked_count GREATER 0)
        string(SUBSTRING "${source_untracked_fingerprint}" 0 12 short_untracked)
        string(APPEND build_id "-u${short_untracked}")
    endif()
    set(platform "${CMAKE_SYSTEM_NAME}")
    if(platform STREQUAL "")
        set(platform "${CMAKE_HOST_SYSTEM_NAME}")
    endif()
    set(architecture "${CMAKE_SYSTEM_PROCESSOR}")
    if(ANDROID)
        set(architecture "${CMAKE_ANDROID_ARCH_ABI}")
    endif()
    if(architecture STREQUAL "")
        set(architecture unknown)
    endif()
    set(compiler "${CMAKE_CXX_COMPILER_ID}")
    set(compiler_version "${CMAKE_CXX_COMPILER_VERSION}")
    foreach(value revision tree source_fingerprint source_dirty source_untracked_count source_untracked_fingerprint origin channel build_id platform architecture compiler compiler_version maturity)
        set(JUDAS_ID_${value} "${${value}}")
        set(JUDAS_ID_${value} "${${value}}" PARENT_SCOPE)
    endforeach()
    set(JUDAS_ID_version "${effective_version}")
    set(JUDAS_ID_version "${effective_version}" PARENT_SCOPE)
    file(MAKE_DIRECTORY "${output_directory}")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/JudasBuildIdentity.h.in" "${output_directory}/JudasBuildIdentity.h" @ONLY)
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/JudasBuildIdentity.json.in" "${output_directory}/judas-build-info.json.in" @ONLY)
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/JudasSourceInfo.json.in" "${output_directory}/JUDAS_SOURCE_INFO.json" @ONLY)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${source_root}/engine-version.json")
    # Reconfigure provenance when a build input changes, including headers and
    # newly introduced files. This avoids a freshly compiled binary retaining
    # the previous configuration's identity. Do not scan historical evidence.
    file(GLOB_RECURSE build_inputs CONFIGURE_DEPENDS LIST_DIRECTORIES false
        "${source_root}/src/*" "${source_root}/cmake/*" "${source_root}/tools/*"
        "${source_root}/scripts/*" "${source_root}/tests/*" "${source_root}/platform/*"
        "${source_root}/packaging/*" "${source_root}/third_party/*" "${source_root}/assets/*")
    list(FILTER build_inputs EXCLUDE REGEX "/(__pycache__|[.]cache|node_modules)/|[.]py[co]$")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${build_inputs})
endfunction()
