// Frozen pre-cutout selection from6315daad. Preserve independently of new constraints.
PlanetSelection ReferencePlanetSelection(const PlanetSurface& s,const std::vector<PlanetView>& views){
 require(!views.empty(),"planet requires at least one view");for(const auto& v:views)require(finite(v.eye)&&std::isfinite(v.fov)&&v.fov>.01&&v.fov<3.13&&v.pixels>0&&std::isfinite(v.orthographicHeight)&&v.orthographicHeight>=0,"invalid planet view");
 auto perView=[&](PlanetTileKey k,const PlanetView& v){auto eye=v.eye;double fov=v.fov;unsigned pixels=v.pixels;const double focal=pixels/(2*std::tan(fov*.5));const V relative=eye-s.settings.center;const double distance=glm::length(relative),minimum=s.settings.radius-s.MaximumHeight();const V direction=distance>0?relative/distance:V(0,1,0);const double horizon=distance>minimum?std::acos(std::clamp(minimum/distance,0.,1.)):3.141592653589793;V c=s.TileCenter(k),normal=unit(c-s.settings.center);double cap=0;for(unsigned x:{0u,1u})for(unsigned y:{0u,1u})cap=std::max(cap,std::acos(std::clamp(glm::dot(normal,unit(s.GridPoint(k,x,y,1)-s.settings.center)),-1.,1.)));const double angle=std::acos(std::clamp(glm::dot(normal,direction),-1.,1.));if(angle>horizon+cap+.01)return 0.;return v.orthographicHeight>0?s.Error(k)*pixels/v.orthographicHeight:s.Error(k)*focal/std::max(1.,glm::length(eye-c)-s.TileRadius(k));};
 auto priority=[&](PlanetTileKey k){double error=0;for(const auto& v:views)error=std::max(error,perView(k,v));return error;};
 struct Item{double error;PlanetTileKey key;bool operator<(const Item& b)const{return error!=b.error?error<b.error:b.key<key;}};std::priority_queue<Item> q;std::set<PlanetTileKey> leaves;for(unsigned f=0;f<6;++f){PlanetTileKey k{f,0,0,0};leaves.insert(k);q.push({priority(k),k});}bool limited=false;
 while(!q.empty()){auto item=q.top();q.pop();if(item.error<=s.settings.pixelError)break;if(item.key.level==s.settings.maxLevel){limited=true;continue;}if(leaves.size()+3>s.settings.maxTiles){limited=true;break;}leaves.erase(item.key);for(unsigned y=0;y<2;++y)for(unsigned x=0;x<2;++x){PlanetTileKey k{item.key.face,item.key.level+1,item.key.x*2+x,item.key.y*2+y};leaves.insert(k);q.push({priority(k),k});}}
 PlanetSelection out;out.leaves.assign(leaves.begin(),leaves.end());out.budgetLimited=limited;for(auto k:out.leaves)out.maximumPixelError=std::max(out.maximumPixelError,priority(k));return out;}
