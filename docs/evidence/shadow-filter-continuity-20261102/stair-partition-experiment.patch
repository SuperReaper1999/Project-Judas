     top = index * .2
-    position, half = (0, top / 2, .35 + index * .25), (.9, top / 2, .18)
+    # Partition the existing stepped solid at each higher step's leading edge.
+    # The old overlapping boxes had coplanar side faces that fought for depth.
+    # These adjoining slabs preserve the exact outer staircase and water stock.
+    front = .35 + index * .25 - .18
+    if index < 14:
+        back = .35 + (index + 1) * .25 - .18
+    else:
+        back = .35 + index * .25 + .18
+    position = (0, top / 2, (front + back) / 2)
+    half = (.9, top / 2, (back - front) / 2)
