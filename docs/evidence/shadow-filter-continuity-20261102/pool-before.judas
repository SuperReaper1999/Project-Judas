JudasScene 3
settings
  name "Large rectangular fluid reference"
  world-origin 0 0 0
  sun-direction .4 .7 .35
  sun-color 1 .98 .92
  ambient .3 .32 .35
  fluid-scale 10
  fluid-update-rate-hz 30
  fluid-hydrostatic-drag-rate 2
  fidelity-policy none
  next-id 36
end

