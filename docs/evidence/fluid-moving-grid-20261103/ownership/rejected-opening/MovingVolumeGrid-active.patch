@@ -300,3 +312,36 @@
-    if (!SolvePressure(faces, rhs, tolerance, cellVolume, step.pressure,
-                       step.iterations, error))
-        return false;
+    auto baseRhs = rhs;
+    for (std::size_t attempt = 0; ; ++attempt) {
+        rhs = baseRhs;
+        for (const auto& f : faces) {
+            if (!f.active)
+                continue;
+            const double predictorFlux = dt * f.aperture * f.predictor;
+            rhs[f.left] += predictorFlux;
+            rhs[f.right] -= predictorFlux;
+        }
+        int iterations = 0;
+        std::fill(step.pressure.begin(), step.pressure.end(), 0.);
+        if (!SolvePressure(faces, rhs, tolerance, cellVolume, step.pressure, iterations, error))
+            return false;
+        step.iterations += iterations;
+        bool changed = false;
+        for (auto& f : faces) {
+            if (f.incomingSign == 0)
+                continue;
+            const double correction = f.conductance *
+                (step.pressure[f.left] - step.pressure[f.right]);
+            const double desired = f.predictor + correction / (dt * f.aperture);
+            if ((f.active && desired * f.incomingSign > 0) ||
+                (!f.active && desired * f.incomingSign < 0)) {
+                f.active = !f.active;
+                changed = true;
+                break;
+            }
+        }
+        if (!changed)
+            break;
+        if (attempt == 63) {
+            error = "newly exposed pressure faces could not satisfy causal donor flow";
+            return false;
+        }
+    }
