diff --git a/cmake/JudasWindowsCrossICU.cmake b/cmake/JudasWindowsCrossICU.cmake
new file mode 100644
index 0000000000000000000000000000000000000000..40cbdb435f9224abb2460ba7cd68cd089e6d589c
--- /dev/null
+++ b/cmake/JudasWindowsCrossICU.cmake
@@ -0,0 +1,54 @@
+# Same ICU implementation/data as other Judas platforms. ICU's generators run
+# on Linux; their output and libraries are built for MinGW, never executed here.
+set(JUDAS_CROSS_DEPENDENCY_JOBS "4" CACHE STRING "Maximum parallel compiler jobs in ICU cross/native dependency builds")
+if(NOT JUDAS_CROSS_DEPENDENCY_JOBS MATCHES "^[1-9][0-9]*$" OR JUDAS_CROSS_DEPENDENCY_JOBS GREATER 64)
+ message(FATAL_ERROR "JUDAS_CROSS_DEPENDENCY_JOBS must be 1-64")
+endif()
+set(JUDAS_ICU_HOST_TOOLS "" CACHE PATH "Existing ICU 76.1 native build directory (config/icucross.mk)")
+set(_icu_archive "${CMAKE_SOURCE_DIR}/third_party/text/icu4c-76_1-src.tgz")
+set(_icu_hash dfacb46bfe4747410472ce3e1144bf28a102feeaa4e3875bac9b4c6cf30f4f3e)
+if(JUDAS_ICU_HOST_TOOLS)
+ if(NOT EXISTS "${JUDAS_ICU_HOST_TOOLS}/config/icucross.mk")
+  message(FATAL_ERROR "JUDAS_ICU_HOST_TOOLS must name a built ICU 76.1 native build directory")
+ endif()
+ set(_icu_host_dependency "")
+else()
+ ExternalProject_Add(judas_icu_host
+  URL "${_icu_archive}" URL_HASH SHA256=${_icu_hash}
+  PREFIX "${CMAKE_BINARY_DIR}/unicode/host"
+  CONFIGURE_COMMAND <SOURCE_DIR>/source/runConfigureICU Linux --disable-shared --enable-static --disable-tests --disable-samples --disable-extras --disable-icuio
+  BUILD_COMMAND make -j${JUDAS_CROSS_DEPENDENCY_JOBS} INSTALL_COMMAND ""
+  LOG_CONFIGURE ON LOG_BUILD ON)
+ set(JUDAS_ICU_HOST_TOOLS "${CMAKE_BINARY_DIR}/unicode/host/src/judas_icu_host-build")
+ set(_icu_host_dependency judas_icu_host)
+endif()
+set(JUDAS_ICU_PREFIX "${CMAKE_BINARY_DIR}/unicode/icu")
+file(MAKE_DIRECTORY "${JUDAS_ICU_PREFIX}/include" "${JUDAS_ICU_PREFIX}/bin")
+set(_icu_cc "${CMAKE_C_COMPILER}")
+set(_icu_cxx "${CMAKE_CXX_COMPILER}")
+if(CMAKE_C_COMPILER_ID MATCHES "Clang")
+ string(APPEND _icu_cc " --target=${CMAKE_C_COMPILER_TARGET}")
+ string(APPEND _icu_cxx " --target=${CMAKE_CXX_COMPILER_TARGET}")
+endif()
+ExternalProject_Add(judas_icu_build
+ URL "${_icu_archive}" URL_HASH SHA256=${_icu_hash}
+ PREFIX "${CMAKE_BINARY_DIR}/unicode/build" DEPENDS ${_icu_host_dependency}
+ CONFIGURE_COMMAND ${CMAKE_COMMAND} -E env "CC=${_icu_cc}" "CXX=${_icu_cxx}"
+  "AR=${CMAKE_AR}" "RANLIB=${CMAKE_RANLIB}" "CFLAGS=-O2" "CXXFLAGS=-O2"
+  <SOURCE_DIR>/source/configure --host=x86_64-w64-mingw32 --with-cross-build=${JUDAS_ICU_HOST_TOOLS}
+  --prefix=${JUDAS_ICU_PREFIX} --disable-shared --enable-static --with-data-packaging=static
+  --disable-tests --disable-samples --disable-extras --disable-icuio --disable-tools
+ BUILD_COMMAND make -j${JUDAS_CROSS_DEPENDENCY_JOBS}
+ # Native pkgdata correctly emits a COFF archive named sicudt.a for MinGW.
+ # Upstream installs it under bin while the stub is named lib/libsicudt.a.
+ # Publish the actual generated data archive at the explicit static link path.
+ INSTALL_COMMAND make install
+ COMMAND ${CMAKE_COMMAND} -E copy_if_different <BINARY_DIR>/lib/sicudt.a "${JUDAS_ICU_PREFIX}/lib/libsicudt.a"
+ BUILD_BYPRODUCTS "${JUDAS_ICU_PREFIX}/lib/libsicuin.a" "${JUDAS_ICU_PREFIX}/lib/libsicuuc.a" "${JUDAS_ICU_PREFIX}/lib/libsicudt.a"
+ LOG_CONFIGURE ON LOG_BUILD ON LOG_INSTALL ON)
+add_library(judas_unicode INTERFACE)
+add_dependencies(judas_unicode judas_icu_build)
+target_compile_definitions(judas_unicode INTERFACE U_STATIC_IMPLEMENTATION)
+target_include_directories(judas_unicode SYSTEM INTERFACE "${JUDAS_ICU_PREFIX}/include")
+target_link_libraries(judas_unicode INTERFACE freetype harfbuzz
+ "${JUDAS_ICU_PREFIX}/lib/libsicuin.a" "${JUDAS_ICU_PREFIX}/lib/libsicuuc.a" "${JUDAS_ICU_PREFIX}/lib/libsicudt.a")
diff --git a/cmake/JudasWindowsCrossRuntime.cmake b/cmake/JudasWindowsCrossRuntime.cmake
new file mode 100644
index 0000000000000000000000000000000000000000..078cb28b7484262cdd7e1daa322eaaa833c97758
--- /dev/null
+++ b/cmake/JudasWindowsCrossRuntime.cmake
@@ -0,0 +1,66 @@
+# MinGW-only staging; the MSVC SDK and its redistribution contract stay separate.
+enable_language(RC)
+file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/generated/judas-cross-$<CONFIG>.rc" CONTENT
+ "1 24 \"${CMAKE_SOURCE_DIR}/packaging/windows/judas.manifest\"\n101 10 \"${CMAKE_BINARY_DIR}/judas-build-info-$<CONFIG>.json\"\n")
+# Resource compilers do not consistently discover JSON includes. Rebuild the
+# resource when configured identity changes, not only when its pathname changes.
+set(_cross_configs ${CMAKE_CONFIGURATION_TYPES} ${CMAKE_BUILD_TYPE})
+foreach(config IN LISTS _cross_configs)
+ set_source_files_properties("${CMAKE_BINARY_DIR}/generated/judas-cross-${config}.rc"
+  PROPERTIES OBJECT_DEPENDS "${CMAKE_BINARY_DIR}/generated/judas-build-info.json.in;${CMAKE_SOURCE_DIR}/packaging/windows/judas.manifest")
+endforeach()
+get_filename_component(_cross_bin "${CMAKE_CXX_COMPILER}" DIRECTORY)
+set(JUDAS_WINDOWS_EXTRA_DLLS "" CACHE STRING "Additional explicit MinGW runtime DLL paths")
+set(_cross_dlls ${JUDAS_WINDOWS_EXTRA_DLLS})
+foreach(name libstdc++-6.dll libgcc_s_seh-1.dll libwinpthread-1.dll libc++.dll libunwind.dll)
+ execute_process(COMMAND "${CMAKE_CXX_COMPILER}" "-print-file-name=${name}" OUTPUT_VARIABLE path OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
+ if(EXISTS "${path}")
+  list(APPEND _cross_dlls "${path}")
+ elseif(EXISTS "${_cross_bin}/${name}")
+  list(APPEND _cross_dlls "${_cross_bin}/${name}")
+ elseif(EXISTS "${_cross_bin}/../x86_64-w64-mingw32/lib/${name}")
+  list(APPEND _cross_dlls "${_cross_bin}/../x86_64-w64-mingw32/lib/${name}")
+ endif()
+endforeach()
+list(REMOVE_DUPLICATES _cross_dlls)
+set(_dll_names "")
+set(_cross_copy COMMAND ${CMAKE_COMMAND} -E true)
+if(_cross_dlls)
+ set(_cross_copy COMMAND ${CMAKE_COMMAND} -E copy_if_different ${_cross_dlls} "$<TARGET_FILE_DIR:judas>"
+                 COMMAND ${CMAKE_COMMAND} -E copy_if_different ${_cross_dlls} "$<TARGET_FILE_DIR:judas>/windows-runtime")
+ foreach(dll IN LISTS _cross_dlls)
+  get_filename_component(name "${dll}" NAME)
+  string(APPEND _dll_names "${name}\n")
+ endforeach()
+endif()
+file(WRITE "${CMAKE_BINARY_DIR}/required-dlls.txt" "${_dll_names}")
+file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/cross-licenses")
+configure_file("${judas_sdl_SOURCE_DIR}/LICENSE.txt" "${CMAKE_BINARY_DIR}/cross-licenses/SDL2.txt" COPYONLY)
+configure_file("${judas_glm_SOURCE_DIR}/copying.txt" "${CMAKE_BINARY_DIR}/cross-licenses/GLM.txt" COPYONLY)
+# Preserve the selected toolchain's own redistribution notices. The Python
+# bundle check rejects missing notices; it does not invent license statements.
+foreach(pair "gcc-mingw-w64-base|GNU-runtime.txt" "mingw-w64-common|MinGW-w64.txt")
+ string(REPLACE "|" ";" fields "${pair}")
+ list(GET fields 0 package)
+ list(GET fields 1 output)
+ if(EXISTS "${_cross_bin}/../share/doc/${package}/copyright")
+  configure_file("${_cross_bin}/../share/doc/${package}/copyright" "${CMAKE_BINARY_DIR}/cross-licenses/${output}" COPYONLY)
+ endif()
+endforeach()
+add_custom_target(judas_windows_runtime
+ COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:judas>/windows-runtime" "$<TARGET_FILE_DIR:judas>/windows-licenses"
+ ${_cross_copy}
+ COMMAND ${CMAKE_COMMAND} -E copy_if_different "${CMAKE_BINARY_DIR}/required-dlls.txt" "$<TARGET_FILE_DIR:judas>/windows-runtime/required-dlls.txt"
+ COMMAND ${CMAKE_COMMAND} -E copy_directory "${CMAKE_BINARY_DIR}/cross-licenses" "$<TARGET_FILE_DIR:judas>/windows-licenses"
+ VERBATIM)
+get_property(_cross_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
+foreach(target IN LISTS _cross_targets)
+ get_target_property(kind ${target} TYPE)
+ if(kind STREQUAL "EXECUTABLE")
+  target_sources(${target} PRIVATE "${CMAKE_BINARY_DIR}/generated/judas-cross-$<CONFIG>.rc")
+  add_dependencies(${target} judas_windows_runtime)
+ endif()
+ if(target MATCHES "_tests$|_performance$|_stress$")
+  set_target_properties(${target} PROPERTIES EXCLUDE_FROM_ALL TRUE)
+ endif()
+endforeach()
