        if(op=="networkForget"){if(!net.Forget(key,error))return JS_ThrowTypeError(c,"%s",error.c_str());return JS_TRUE;}
        if(op=="networkOwner"){if(!net.SetOwner(key,String(c,arg(3)),error))return JS_ThrowTypeError(c,"%s",error.c_str());return JS_UNDEFINED;}
        if(op=="networkState"){std::string data;if(!s->Json(arg(3),data,error)||!net.SetState(key,data,error))return JS_ThrowTypeError(c,"%s",error.c_str());return JS_UNDEFINED;}
        return JS_ThrowTypeError(c,"Unknown network operation");
    }
