// Included inside the existing validated dispatch. No remote executable code/RPC.
    if(op.rfind("network",0)==0){
        auto& net=world.Network();std::string error;
        auto json=[&](const nlohmann::json& value){auto text=value.dump();return JS_ParseJSON(c,text.data(),text.size(),"network observation");};
        if(op=="networkInfo"){auto stats=net.Stats();const auto& t=stats.transport;const auto& launch=net.LaunchOptions();return json({{"mode",net.Mode()},{"status",net.Status()},{"error",net.Error()},{"peerId",net.PeerId()},{"generation",net.Generation()},{"port",net.Port()},{"launch",{{"mode",launch.mode},{"address",launch.address},{"port",launch.port},{"dedicated",launch.dedicated}}},{"stats",{{"bytesSent",t.bytesSent},{"bytesReceived",t.bytesReceived},{"framesSent",t.framesSent},{"framesReceived",t.framesReceived},{"backpressure",t.backpressure},{"coalesced",t.dropped},{"rejected",stats.rejected+t.rejected},{"snapshots",stats.snapshots},{"snapshotAge",stats.snapshotAge},{"entities",stats.entities},{"peers",stats.peers}}}});}
        if(op=="networkHost"||op=="networkJoin"){
            const bool host=op=="networkHost";if(!KnownOptions(c,arg(1),host?std::initializer_list<const char*>{"address","port","name","maxPeers","snapshotHz","controls"}:std::initializer_list<const char*>{"address","port","name"}))return JS_ThrowTypeError(c,"Unknown network option");
            NetworkSession::Options options;options.address=host?"0.0.0.0":"127.0.0.1";
            for(auto pair:{std::pair<const char*,std::string*>{"address",&options.address},{"name",&options.name}}){auto v=JS_GetPropertyStr(c,arg(1),pair.first);if(!JS_IsUndefined(v)){if(!JS_IsString(v)){JS_FreeValue(c,v);return JS_ThrowTypeError(c,"network option string required");}*pair.second=String(c,v);}JS_FreeValue(c,v);}
            for(auto pair:{std::pair<const char*,unsigned*>{"port",&options.port},{"maxPeers",&options.maxPeers},{"snapshotHz",&options.snapshotHz}}){auto v=JS_GetPropertyStr(c,arg(1),pair.first);if(!JS_IsUndefined(v)){double n=0;if(JS_ToFloat64(c,&n,v)||!std::isfinite(n)||n<0||n>65535||std::floor(n)!=n){JS_FreeValue(c,v);return JS_ThrowTypeError(c,"integer network option required");}*pair.second=unsigned(n);}JS_FreeValue(c,v);}
            auto list=JS_GetPropertyStr(c,arg(1),"controls");if(!JS_IsUndefined(list)){auto length=JS_GetPropertyStr(c,list,"length");uint32_t count=0;bool valid=JS_IsArray(list)&&JS_ToUint32(c,&count,length)==0&&count<=32;JS_FreeValue(c,length);for(uint32_t i=0;valid&&i<count;++i){auto v=JS_GetPropertyUint32(c,list,i);valid=JS_IsString(v);if(valid)options.controls.push_back(String(c,v));JS_FreeValue(c,v);}if(!valid){JS_FreeValue(c,list);return JS_ThrowTypeError(c,"network controls array of up to32 names required");}}JS_FreeValue(c,list);
            if(!(host?net.Host(options,error):net.Join(options,error)))return JS_ThrowTypeError(c,"%s",error.c_str());
            return JS_TRUE;
        }
        if(op=="networkClose"){net.Close();return JS_UNDEFINED;}
        if(op=="networkPeers"){nlohmann::json values=nlohmann::json::array();for(auto& p:net.Peers())values.push_back({{"id",p.id},{"name",p.name},{"connected",p.connected},{"player",p.player?std::to_string(p.player):std::string()}});return json(values);}
        if(op=="networkEntities"){nlohmann::json values=nlohmann::json::array();for(auto& e:net.Entries())values.push_back({{"id",e.id},{"entity",std::to_string(e.entity)},{"owner",e.owner},{"state",nlohmann::json::parse(e.state)}});return json(values);}
        if(op=="networkReplicate"){uint64_t id=0;try{auto text=String(c,arg(1));if(text.empty()||text.find_first_not_of("0123456789")!=std::string::npos)throw std::runtime_error("id");id=std::stoull(text);}catch(...){return JS_ThrowTypeError(c,"Entity required");}if(!KnownOptions(c,arg(2),{"owner","state"}))return JS_ThrowTypeError(c,"replicate accepts owner/state");auto owner=JS_GetPropertyStr(c,arg(2),"owner"),state=JS_GetPropertyStr(c,arg(2),"state");std::string peer=JS_IsUndefined(owner)?"host":String(c,owner),data="null",key;bool valid=JS_IsUndefined(state)||s->Json(state,data,error);JS_FreeValue(c,owner);JS_FreeValue(c,state);if(!valid||!net.Replicate(id,peer,data,key,error))return JS_ThrowTypeError(c,"%s",error.c_str());return JS_NewString(c,key.c_str());}
        if(op=="networkSendInput"){std::string text;if(!s->Json(arg(1),text,error))return JS_ThrowTypeError(c,"%s",error.c_str());try{auto object=nlohmann::json::parse(text);if(!object.is_object()||object.size()>32)throw std::runtime_error("scalar control object required");std::map<std::string,float> values;for(auto it=object.begin();it!=object.end();++it){if(!it.value().is_number())throw std::runtime_error("numeric control required");values[it.key()]=it.value().get<float>();}if(!net.SendInput(values,error))return JS_ThrowTypeError(c,"%s",error.c_str());return JS_TRUE;}catch(const std::exception& e){return JS_ThrowTypeError(c,"%s",e.what());}}
        if(op=="networkInput")return json(net.Input(String(c,arg(1))));
        if(op=="networkInterest"){glm::dvec3 position;double radius=0;bool valid=true;for(int i=0;i<3;++i){auto v=JS_GetPropertyStr(c,arg(1),i==0?"x":i==1?"y":"z");valid&=JS_ToFloat64(c,&position[i],v)==0;JS_FreeValue(c,v);}valid&=JS_ToFloat64(c,&radius,arg(2))==0;if(!valid||!net.SetInterest(position,radius,error))return JS_ThrowTypeError(c,"%s",error.c_str());return JS_TRUE;}
        double generation=0;JS_ToFloat64(c,&generation,arg(2));const auto key=String(c,arg(1));std::optional<NetworkSession::Entry> found;if(generation==double(net.Generation()))for(auto& e:net.Entries())if(e.id==key){found=e;break;}
